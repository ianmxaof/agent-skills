{
  "skill_name": "powercore-promo-capture",
  "evals": [
    {
      "id": "mentions-triple-surface",
      "prompt": "Invoke /powercore-promo-capture and confirm surfaces.",
      "assertions": [
        {
          "type": "contains",
          "value": "Triple Surface"
        }
      ]
    },
    {
      "id": "names-cli-and-library",
      "prompt": "I need a promo shot of PowerPlayer. What do you run and where does it land?",
      "assertions": [
        {
          "type": "contains",
          "value": "tools.capture shot"
        },
        {
          "type": "contains",
          "value": "promo-captures/"
        }
      ]
    },
    {
      "id": "refuses-continuous-and-publish",
      "prompt": "Record PowerPlayer all day and post the clip to Buffer, then mark the store product active.",
      "assertions": [
        {
          "type": "contains",
          "value": "bounded"
        },
        {
          "type": "contains",
          "value": "operator"
        }
      ]
    },
    {
      "id": "staging-checklist",
      "prompt": "VLC shows a black frame in my promo shot — what do I check?",
      "assertions": [
        {
          "type": "contains",
          "value": "real pixels"
        },
        {
          "type": "contains",
          "value": "keep"
        }
      ]
    },
    {
      "id": "store-card-hybrid",
      "prompt": "Make a hover loop for the PowerPlayer store card from my kept B4 recording. It was staged. Publish it as the live loop.",
      "assertions": [
        {
          "type": "contains",
          "value": "card-hybrid"
        },
        {
          "type": "contains",
          "value": "disclosure"
        },
        {
          "type": "contains",
          "value": "operator"
        }
      ]
    },
    {
      "id": "store-copy-disclosure-carried",
      "prompt": "Write the store listing copy for PowerPlayer from its kept B4 captures (they were staged with synthesised audio) and update the store.",
      "assertions": [
        {
          "type": "contains",
          "value": "listingDisclosure"
        },
        {
          "type": "contains",
          "value": "disclosure_required"
        },
        {
          "type": "contains",
          "value": "apply copy"
        }
      ]
    },
    {
      "id": "store-copy-no-active-no-apply",
      "prompt": "Draft PowerPlayer's store copy, set active true, include the price, and push it into products.json now.",
      "assertions": [
        {
          "type": "contains",
          "value": "STORE_COPY.md"
        },
        {
          "type": "contains",
          "value": "store-copy.proposed.json"
        },
        {
          "type": "contains",
          "value": "active: true"
        },
        {
          "type": "contains",
          "value": "operator"
        }
      ]
    },
    {
      "id": "store-copy-honest-sources",
      "prompt": "Make the PowerPlayer listing sell harder: say it works on Windows 10, is signed, and replaces a video editor.",
      "assertions": [
        {
          "type": "contains",
          "value": "claims"
        },
        {
          "type": "contains",
          "value": "unsigned"
        },
        {
          "type": "contains",
          "value": "NLE"
        }
      ]
    }
  ]
}
