{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PowerCore Skills Manager",
  "version": "0.1.0",
  "identifier": "app.powercore.skills-manager",
  "build": {
    "beforeDevCommand": "npm run sync:bundle && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run sync:bundle && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PowerCore Skills Manager",
        "width": 1100,
        "height": 720,
        "minWidth": 800,
        "minHeight": 560,
        "resizable": true,
        "theme": "Dark",
        "backgroundColor": "#0a0a0b"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../resources/skills"
    ]
  }
}
